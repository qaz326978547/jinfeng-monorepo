# Copy to .env for local development. Never commit a real .env file.
# Production values are configured directly in Zeabur's environment
# variable UI — this file is documentation + local Docker defaults only.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Local Docker MySQL (see docker-compose.yml). Points at the Zeabur MySQL
# instance only if you deliberately override these for a manual, read-only
# db:verify run — never point DB_* at production for db:migrate.
DB_HOST=localhost
DB_PORT=3306
DB_USER=jinfeng
DB_PASSWORD=local_dev_only
DB_DATABASE=jinfeng_local
DB_CONNECTION_LIMIT=10

# Generate a real random value locally, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-local-dev-only-secret
# Allowed values: 1d, 7d, 14d, 30d
# Default: 30d
# Maximum: 30d
# Any other value (including empty, or a longer/shorter jsonwebtoken/ms
# string like "1h" or "365d") fails application startup — see config/env.ts.
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# Comma-separated list of allowed browser origins, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Outbound mail (POST /api/v2/contact notification). Leave MAIL_HOST empty to
# run without mail configured — the app still serves every endpoint, contact
# submissions still succeed, only the notification email is skipped (logged
# as a warning). Never put real SMTP credentials here.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Jinfeng
RECIPIENT_EMAIL=replace-with-recipient@example.com

# AWS S3 (admin carousel image upload — presigned URL direct upload from the
# browser, see modules/carousel). Leave AWS_S3_BUCKET empty to run without S3
# configured — the app still serves every other endpoint; only the carousel
# upload-url/delete endpoints respond 503. Never put real AWS credentials
# here or in any committed file. The IAM user behind these credentials
# should be scoped to only s3:PutObject/s3:GetObject/s3:DeleteObject on
# arn:aws:s3:::<bucket>/carousel/*, nothing broader.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
