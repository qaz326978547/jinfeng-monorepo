# Copy to .env for local development. Never commit a real .env file.
#
# NOTE: these variable names were verified against actual source code usage
# (nuxt.config.ts, store/usePublicStore.ts, plugins/vue-gtm.client.ts), not
# just README.md — README.md lists slightly different names
# (NUXT_PUBLIC_API_BASE_URL / NUXT_PUBLIC_GTM_ID) that do not match the code.

# Public site URL, used for canonical URLs / SEO metadata.
NUXT_PUBLIC_SITE_URL=https://laborservice5690.com

# Backend API base URL (only read when NODE_ENV=production; local dev falls
# back to http://127.0.0.1:9001 automatically, see store/usePublicStore.ts).
NUXT_API_BASE_URL=https://your-backend-domain.example.com

# Google Tag Manager container ID (see plugins/vue-gtm.client.ts).
VITE_GTM_ID=GTM-XXXXXXX
