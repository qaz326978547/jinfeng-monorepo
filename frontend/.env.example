# Copy to .env for local development. Never commit a real .env file.
#
# All three variables below are Nuxt's standard runtimeConfig.public override
# convention: NUXT_PUBLIC_<KEY> maps to runtimeConfig.public.<camelCaseKey> in
# nuxt.config.ts. Nothing in this app reads process.env directly anymore — see
# nuxt.config.ts, store/usePublicStore.ts, plugins/vue-gtm.client.ts.

# Backend API origin (no trailing path — /api/v2 is appended in
# store/usePublicStore.ts). Defaults to http://127.0.0.1:8080 (matches
# backend/docker-compose.yml) when unset, so this only needs to be set here if
# your local backend runs somewhere else.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Public site URL, used for canonical URLs / SEO metadata. Defaults to the
# production domain when unset — set this locally so canonical tags don't
# point at production while developing.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager container ID (see plugins/vue-gtm.client.ts). Leave empty
# to run without GTM — it's simply disabled, not a startup failure.
NUXT_PUBLIC_GTM_ID=
